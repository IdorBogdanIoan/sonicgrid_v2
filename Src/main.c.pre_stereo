#include <stdio.h>
#include <math.h>


/* USER CODE END Includes */

/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */

/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
/* 512 cuvinte de 32 de biti per jumatate de buffer.
   Slotul e stereo, deci 512 cuvinte = 256 esantioane pe canalul stang.
   La 16 kHz asta inseamna un callback la fiecare 16 ms. */
#define HALF_WORDS   512u
#define BUF_WORDS    (HALF_WORDS * 2u)

/* INMP441 scoate 24 de biti cu semn, deci scala completa e 2^23. */
#define FULL_SCALE   8388608.0f


/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/

COM_InitTypeDef BspCOMInit;

/* USER CODE BEGIN PV */
static int32_t audio_buf[BUF_WORDS] __attribute__((aligned(32)));

volatile float    g_dbfs     = -120.0f;  /* nivelul blocului curent */
volatile float    g_dbfs_max = -120.0f;  /* varful de la ultima afisare */
volatile uint32_t g_blocuri  = 0u;       /* cate jumatati am procesat */
volatile uint32_t g_erori    = 0u;       /* erori SAI, tipic overrun */
volatile int32_t  g_brut     = 0;        /* ultimul esantion brut */


/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void SystemPower_Config(void);
/* USER CODE BEGIN PFP */
static void proceseaza(const int32_t *p, uint32_t cuvinte);


/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
/* Calculeaza RMS-ul pe canalul stang si il converteste in dBFS.

   Bufferul contine perechi stanga/dreapta, de aceea pasul e 2.
   Microfonul are L/R legat la masa, deci vorbeste doar pe stanga,
   adica pe indicii pari. Canalul drept ramane zero.

   INMP441 aliniaza cei 24 de biti la stanga intr-un slot de 32,
   deci deplasarea cu 8 la dreapta da valoarea cu semn corecta. */
static void proceseaza(const int32_t *p, uint32_t cuvinte)
{
  float    acc = 0.0f;
  uint32_t n   = 0u;

  for (uint32_t i = 0u; i < cuvinte; i += 2u)
  {
    int32_t s = p[i] >> 8;
    acc += (float)s * (float)s;
    n++;
  }
  if (n == 0u)
  {
    return;
  }

  g_brut = p[0] >> 8;

  float rms = sqrtf(acc / (float)n);
  float db  = 20.0f * log10f((rms + 1e-6f) / FULL_SCALE);

  g_dbfs = db;
  if (db > g_dbfs_max)
  {
    g_dbfs_max = db;
  }
  g_blocuri++;
}

/* Prima jumatate s-a umplut, o procesam cat se umple a doua. */
void HAL_SAI_RxHalfCpltCallback(SAI_HandleTypeDef *hsai)
{
  if (hsai->Instance == SAI1_Block_A)
  {
    proceseaza(&audio_buf[0], HALF_WORDS);
  }
}

/* A doua jumatate s-a umplut, DMA-ul s-a intors deja la inceput. */
void HAL_SAI_RxCpltCallback(SAI_HandleTypeDef *hsai)
{
  if (hsai->Instance == SAI1_Block_A)
  {
    proceseaza(&audio_buf[HALF_WORDS], HALF_WORDS);
  }
}

/* Daca numarul asta creste, SAI-ul pierde esantioane. */
void HAL_SAI_ErrorCallback(SAI_HandleTypeDef *hsai)
{
  (void)hsai;
  g_erori++;
}


/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the System Power */
  SystemPower_Config();

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_GPDMA1_Init();
  MX_ICACHE_Init();
  MX_SAI1_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Initialize leds */
  BSP_LED_Init(LED_GREEN);
  BSP_LED_Init(LED_BLUE);
  BSP_LED_Init(LED_RED);

  /* Initialize USER push-button, will be used to trigger an interrupt each time it's pressed.*/
  BSP_PB_Init(BUTTON_USER, BUTTON_MODE_EXTI);

  /* Initialize COM1 port (115200, 8 bits (7-bit data + 1 stop bit), no parity */
  BspCOMInit.BaudRate   = 115200;
  BspCOMInit.WordLength = COM_WORDLENGTH_8B;
  BspCOMInit.StopBits   = COM_STOPBITS_1;
  BspCOMInit.Parity     = COM_PARITY_NONE;
  BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
  if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE)
  {
    Error_Handler();
  }

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  BSP_COM_SelectLogPort(COM1);

  printf("\r\n=== SonicGrid, nod STM32U5A5 ===\r\n");
  printf("SAI1: 16 kHz, 32 biti, 2 sloturi, I2S standard\r\n");
  printf("SYSCLK: %lu Hz\r\n", HAL_RCC_GetSysClockFreq());

  if (HAL_SAI_Receive_DMA(&hsai_BlockA1, (uint8_t *)audio_buf, BUF_WORDS) != HAL_OK)
  {
    printf("EROARE: HAL_SAI_Receive_DMA a esuat\r\n");
    Error_Handler();
  }
  printf("Captura pornita. Bate din palme langa microfon.\r\n\r\n");

  uint32_t t_ultim = HAL_GetTick();

  while (1)
  {

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    if ((HAL_GetTick() - t_ultim) >= 200u)
    {
      t_ultim = HAL_GetTick();

      /* Afisam ca intreg, ca sa nu depindem de printf cu virgula mobila. */
      printf("dBFS %4ld   varf %4ld   blocuri %6lu   erori %lu   brut %ld\r\n",
             (int32_t)g_dbfs, (int32_t)g_dbfs_max,
             g_blocuri, g_erori, g_brut);

      g_dbfs_max = -120.0f;
      BSP_LED_Toggle(LED_GREEN);
    }

  }
  /* USER CODE END 3 */
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

